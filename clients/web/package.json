{
  "name": "@knowledge-mesh/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "playwright-core": "1.62.1"
  },
  "scripts": {
    "dev": "vite build --watch",
    "generate": "openapi-typescript ../../server/api/openapi.yaml -o src/api/schema.d.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:offline": "node scripts/test-offline.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html",
    "build": "npm run check && vite build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.130.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "0.18.7",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-markdown": "10.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/katex": "0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
