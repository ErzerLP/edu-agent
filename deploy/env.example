# Copy to a private .env file and run Compose with --env-file.
# Never commit the resulting .env file. Replace every placeholder locally.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
SERVER_PORT=8080

# Leave all model values empty to run without an LLM during platform development.
# Configure all four values together when enabling an OpenAI-compatible endpoint.
MODEL_REQUIRED=false
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_CONTEXT_WINDOW=

# Nocturne is an internal sidecar. This must be an imported OCI image reference
# or registry reference pinned to the platform-manifest digest verified by
# deploy/nocturne/image.lock.json. Compose never builds this image.
NOCTURNE_IMAGE=registry.example/edu-agent/nocturne@sha256:fff7d399a0fc4eb99a5ed04667f781173fb4006ddb0e6a22dd2c63ce6559a039

# Nocturne owns a separate PostgreSQL database and credentials. Use URL-safe
# values because Compose places the password in a PostgreSQL connection URL.
NOCTURNE_POSTGRES_DB=nocturne
NOCTURNE_POSTGRES_USER=nocturne
NOCTURNE_POSTGRES_PASSWORD=replace-with-a-distinct-long-random-database-password

# The bridge API token and maintenance token are separate credentials and must
# differ. Generate independent random values of at least 32 serialized chars.
NOCTURNE_BRIDGE_API_TOKEN=replace-with-an-independent-bridge-writer-token-of-at-least-32-characters
NOCTURNE_MAINTENANCE_TOKEN=replace-with-an-independent-32-byte-base64url-maintenance-token

# Canonical unpadded base64url encoding of exactly 32 random bytes. This key is
# separate from both Nocturne bearer tokens and both PostgreSQL passwords.
NOCTURNE_BACKUP_MASTER_WRAPPING_KEY=replace-with-canonical-unpadded-base64url-for-32-random-bytes

# Production defaults are 24h and 30d. Shorter positive values are intended only
# for the isolated contracttests/nocturne/run-compose-e2e.sh gate.
NOCTURNE_BACKUP_CONTROLLER_INTERVAL=24h
NOCTURNE_BACKUP_RETENTION=720h
