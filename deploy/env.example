# Copy to a private .env file and run Compose with --env-file.
# Never commit the resulting .env file. Replace every placeholder locally.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
SERVER_PORT=8080

# The local administration UI is available only through a loopback transport
# boundary. Leave it disabled until an independent random token has been generated.
# The token must be the canonical unpadded base64url encoding of exactly 32 random
# bytes; it is never stored in PostgreSQL or returned by the API. Direct server
# runs keep the trusted proxy setting false. deploy/compose.yaml sets it true only
# because the host port is explicitly published on 127.0.0.1.
ADMIN_UI_ENABLED=false
ADMIN_UI_TOKEN=
ADMIN_UI_TRUSTED_LOOPBACK_PROXY=false
# Direct server runs may set an absolute private path to enable NoteSync settings
# persistence from the WebUI. Compose supplies /var/lib/edu-agent/private/admin-settings.json.
ADMIN_UI_SETTINGS_FILE=
# This does not reuse ALLOW_INSECURE_NON_LOOPBACK. Keep it false unless a
# separately trusted non-loopback NoteSync endpoint cannot provide TLS.
NOTESYNC_ALLOW_INSECURE_NON_LOOPBACK=false

# Leave all model values empty to run without an LLM during platform development.
# Configure all four values together when enabling an OpenAI-compatible endpoint.
MODEL_REQUIRED=false
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_CONTEXT_WINDOW=

# Offline Objective pack signing is enabled only when all four values are set.
# Generate an Ed25519 key locally; provide the canonical unpadded Base64url
# encoding of the complete 64-byte private key. Never commit the real key.
OFFLINE_SIGNER_KEY_ID=replace-with-a-stable-key-id
OFFLINE_SIGNER_PRIVATE_KEY=replace-with-canonical-unpadded-base64url-for-64-byte-ed25519-private-key
OFFLINE_SIGNER_ISSUED_AT=replace-with-utc-rfc3339-issue-time
OFFLINE_SIGNER_NOT_AFTER=replace-with-later-utc-rfc3339-expiry-time
# Optional for rotation: ordered JSON envelopes from revision 1 through the
# current manifest. The private key above must match the final active key.
OFFLINE_SIGNER_MANIFEST_CHAIN=

# Versioned HMAC keys for offline-device privacy purge challenges. Use one or
# more `version:canonical-unpadded-base64url-32-byte-key` entries; the greatest
# version signs new challenges and older entries remain available for rotation.
# Never commit real challenge keys.
PRIVACY_OFFLINE_CHALLENGE_KEYS=2:replace-with-canonical-unpadded-base64url-for-32-random-bytes

# Nocturne is an internal sidecar. This must be an imported OCI image reference
# or registry reference pinned to the platform-manifest digest verified by
# deploy/nocturne/image.lock.json. Compose never builds this image.
NOCTURNE_IMAGE=registry.example/edu-agent/nocturne@sha256:fff7d399a0fc4eb99a5ed04667f781173fb4006ddb0e6a22dd2c63ce6559a039

# Nocturne owns a separate PostgreSQL database and credentials. Use URL-safe
# values because Compose places the password in a PostgreSQL connection URL.
# Compose keeps PostgreSQL data, encrypted backups, and Nocturne snapshots on
# three independent named volumes; rollback must never reuse the database one.
NOCTURNE_POSTGRES_DB=nocturne
NOCTURNE_POSTGRES_USER=nocturne
NOCTURNE_POSTGRES_PASSWORD=replace-with-a-distinct-long-random-database-password

# The bridge API token and maintenance token are separate credentials and must
# differ. Generate independent random values of at least 32 serialized chars.
# Compose also uses the maintenance token for the internal migration lease guard;
# it is passed only as a container secret environment value and is never logged.
NOCTURNE_BRIDGE_API_TOKEN=replace-with-an-independent-bridge-writer-token-of-at-least-32-characters
NOCTURNE_MAINTENANCE_TOKEN=replace-with-an-independent-32-byte-base64url-maintenance-token

# Canonical unpadded base64url encoding of exactly 32 random bytes. This key is
# separate from both Nocturne bearer tokens and both PostgreSQL passwords.
NOCTURNE_BACKUP_MASTER_WRAPPING_KEY=replace-with-canonical-unpadded-base64url-for-32-random-bytes

# Production defaults are 24h and 30d. Shorter positive values are intended only
# for the isolated contracttests/nocturne/run-compose-e2e.sh gate.
NOCTURNE_BACKUP_CONTROLLER_INTERVAL=24h
NOCTURNE_BACKUP_RETENTION=720h
